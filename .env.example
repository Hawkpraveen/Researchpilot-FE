# API used for authentication and live research requests.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Enables the development demo-workspace button; production API disables the endpoint.
VITE_DEMO_MODE=true
# Set true only when intentionally testing the static demo research dataset.
VITE_RESEARCH_DEMO_MODE=false
# Google Cloud web OAuth client; authorize http://localhost:8080 as a JS origin.
VITE_GOOGLE_CLIENT_ID=
# Microsoft Entra SPA application ID; register http://localhost:8080/redirect.html as its redirect URI.
VITE_MICROSOFT_CLIENT_ID=
# Use "common" to accept personal Microsoft accounts and work/school accounts.
VITE_MICROSOFT_TENANT_ID=common
